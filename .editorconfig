root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,sln}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true

[*.sln]
end_of_line = crlf
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are tool-generated (dotnet ef); the formatter leaves them as generated.
[backend/**/Data/Migrations/*.cs]
generated_code = true
