<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>5507c933-b39a-4530-9d26-d129eadfe28b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.54.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supabase's public root CA, for SSL Mode=VerifyFull (research R12). Public, not a secret. -->
    <None Include="certs\*.crt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy of contracts/ai-estimate.schema.json; sent to Claude as the structured-output schema. -->
    <EmbeddedResource Include="Ai\ai-estimate.schema.json" LogicalName="MacroCounter.Api.Ai.ai-estimate.schema.json" />
    <None Include="Ai\ai-estimate.schema.json" CopyToOutputDirectory="PreserveNewest" Link="ai-estimate.schema.json" />
  </ItemGroup>

</Project>
