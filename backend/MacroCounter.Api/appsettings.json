{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "Effort": "medium"
  },
  "Security": {
    // Origins come from appsettings.{Environment}.json or the host's settings, never a shared default:
    // .NET merges arrays by index, so a base list would leak into Production.
    "Session": {
      "IdleTimeout": "1.00:00:00",
      "AbsoluteLifetime": "7.00:00:00",
      "SetupLifetime": "00:15:00"
    },
    "SignIn": {
      "PerIpLimit": 20,
      "PerIpWindow": "00:15:00",
      "PerUsernameFailures": 10,
      "PerUsernameWindow": "00:15:00",
      "LockoutFailures": 10,
      "LockoutDuration": "00:15:00"
    },
    "Password": {
      "MinLength": 12,
      "MaxLength": 128,
      "Pbkdf2Iterations": 210000
    },
    "Totp": {
      "ReplayWindow": "00:05:00",
      "SetupMaxFailures": 5
    }
  },
  "Limits": {
    "Ai": {
      "BurstPerMinute": 6,
      "PerUserDaily": 30,
      "GlobalDaily": 200,
      "GlobalMonthly": 3000,
      "WorstCaseCostPerRequestUsd": 0.35
    }
  }
}
